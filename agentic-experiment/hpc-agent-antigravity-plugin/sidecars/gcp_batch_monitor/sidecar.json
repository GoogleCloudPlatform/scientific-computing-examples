{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Google Cloud Batch Monitor",
  "description": "Monitors Google Cloud Batch nodes in use, active and 30-day Batch jobs with execution durations, and per-user runtime duration statistics over the last 30 days.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Google Cloud Batch Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Google Batch Monitor"
      }
    ]
  }
}

