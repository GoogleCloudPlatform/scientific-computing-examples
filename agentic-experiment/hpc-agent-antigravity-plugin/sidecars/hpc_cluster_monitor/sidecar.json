{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "HPC Cluster & Slurm Monitor",
  "description": "Monitors running HPC instances over time (30-day statistics), Slurm workload & job ownership by user, and active HPC storage systems (Managed Lustre, Filestore, GCS).",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "HPC Cluster & Slurm Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "HPC & Slurm Monitor"
      }
    ]
  }
}

